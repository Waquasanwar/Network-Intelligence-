# Copy to .env.local and fill in. Never commit real values.

# Notion internal integration secret (https://www.notion.so/profile/integrations).
# Share the "Work Journal" page with the integration so it can read and write the databases.
# Leave blank to run in demo mode with sample data held in memory.
NOTION_TOKEN=""

# Data source (collection) IDs of the three databases. These defaults are the ones already
# created in your workspace under "Work Journal".
NOTION_ENTRIES_DS="41aedc4c-0659-81ab-b67a-000b2f61a672"
NOTION_PROJECTS_DS="41aedc4c-0659-81be-82c2-000b62c660ed"
NOTION_PEOPLE_DS="41aedc4c-0659-818e-99bf-000b505e1e0c"

# Passcode for signing in to the app. Required in production.
APP_PASSCODE=""
# Random string used to sign the session cookie: openssl rand -base64 32
AUTH_SECRET=""

# Bearer token for POST /api/capture (iOS Shortcuts, Raycast, Zapier...). Leave blank to disable.
CAPTURE_TOKEN=""

# Your timezone, used when the capture API resolves words like "tomorrow" or "fri".
JOURNAL_TIMEZONE="Europe/London"
