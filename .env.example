# Copy to .env and fill in. Never commit .env.
# App traffic uses DATABASE_URL (pooled in production). Migrations use DIRECT_URL (a direct,
# non-pooled connection). Locally, point both at the same database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/network_intelligence?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/network_intelligence?schema=public"

# Rate limiting store (sign-in brute-force protection). Required in production so the limiter is
# shared across serverless instances; with these blank it falls back to best-effort in-memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Hide the demo-account panel on the login page unless explicitly enabled. Keep false in production.
SHOW_DEMO_ACCOUNTS="false"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional: Microsoft Entra ID (OIDC) sign-in. Leave blank to use email/password for the prototype.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# AI provider abstraction. "heuristic" runs entirely locally with no external calls.
# Set to "anthropic" and provide a key to use Claude for conversation structuring and match explanations.
AI_PROVIDER="heuristic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# Scheduling providers. Manual scheduling always works.
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_CLIENT_SECRET=""
MICROSOFT_GRAPH_TENANT_ID="common"
CALENDLY_CLIENT_ID=""
CALENDLY_CLIENT_SECRET=""
CALENDLY_WEBHOOK_SIGNING_KEY=""

# Days after which an availability status is treated as stale
AVAILABILITY_STALE_DAYS="45"
