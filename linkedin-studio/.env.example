# ── Notion (required) ────────────────────────────────────────────────
# Create an internal integration at https://www.notion.so/my-integrations,
# share a page with it, then run `npm run setup:notion` to create the databases.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
# Filled in by `npm run setup:notion` (data source IDs):
NOTION_POSTS_DS=
NOTION_SNAPSHOTS_DS=
NOTION_DAILY_DS=
NOTION_SWIPE_DS=
NOTION_CONFIG_DS=

# ── Claude writing assistant (optional; the app works without it) ────
ANTHROPIC_API_KEY=

# ── LinkedIn (optional; import works without it) ─────────────────────
# App from https://www.linkedin.com/developers/apps
# Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Add "Community Management API" later for post analytics (needs approval).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Add r_member_postAnalytics once LinkedIn approves it.
LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_API_VERSION=202510

# ── App ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3100
# Protects the whole app with a browser password prompt (user: anything).
APP_PASSWORD=
# 32+ random chars. Encrypts the LinkedIn token before it is stored in Notion.
APP_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/sync.
CRON_SECRET=
