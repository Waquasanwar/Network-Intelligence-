# Copy to your secrets vault, not to a file in the repo. All identities are read-only.
SECOPS_MODE=sample            # sample | live
SECOPS_TRANSPORT=stdio        # stdio | http
SECOPS_SNAPSHOT_DIR=./snapshots

# Microsoft Entra ID service principal (Sentinel + Defender for Cloud)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENTINEL_WORKSPACE_ID=
DEFENDER_SUBSCRIPTION_IDS=    # comma-separated

# GitLab (group access token, read_api scope)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_GROUPS=                # comma-separated full paths

# Mimecast API 2.0 application
MIMECAST_CLIENT_ID=
MIMECAST_CLIENT_SECRET=
