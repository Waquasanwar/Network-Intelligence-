# Put these in your secrets vault / Container Apps settings, never in a file in the repo.
# Every identity below is read-only. See SOURCES.md for the exact roles to grant.

SECOPS_MODE=live              # sample | live
SECOPS_TRANSPORT=stdio        # stdio | http (web.py always serves http)
SECOPS_DATA_DIR=/app/data     # weekly CSV exports and metrics.json
SECOPS_SNAPSHOT_DIR=/app/snapshots
SECOPS_CACHE_MINUTES=60
SECOPS_SLA_DAYS=critical=15,high=30,medium=90,low=180

# Sign-in for the /mcp endpoint (Claude Enterprise connector)
SECOPS_AUTH=entra
SECOPS_AUTH_TENANT_ID=
SECOPS_AUTH_AUDIENCE=api://secops-metrics
SECOPS_AUTH_SCOPE=SecOps.Read
SECOPS_PUBLIC_URL=https://secops-metrics.example.com/mcp

# Microsoft (Sentinel, Defender XDR / for Endpoint / for Cloud, Entra ID).
# On Azure the container's managed identity is used automatically; these three are only
# for running elsewhere with a service principal.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENTINEL_WORKSPACE_ID=
SECOPS_DEFENDER_XDR=1         # turn on Defender XDR incidents and Defender for Endpoint devices and vulnerabilities
MDE_API_URL=https://api.securitycenter.microsoft.com
DEFENDER_SUBSCRIPTION_IDS=    # Defender for Cloud, comma-separated
SECOPS_ENTRA_RISK=1           # Entra ID risky users (needs Entra ID P2)

# SentinelOne
S1_CONSOLE_URL=https://yourco.sentinelone.net
S1_API_TOKEN=
SECOPS_IN_SCOPE_ENDPOINTS=    # endpoints that should have an agent, for the coverage ring

# CyberArk (cloud = Privilege Cloud, selfhosted = PAM self-hosted)
CYBERARK_MODE=cloud
CYBERARK_PVWA_URL=https://yourco.privilegecloud.cyberark.cloud
CYBERARK_IDENTITY_URL=https://abc1234.id.cyberark.cloud
CYBERARK_CLIENT_ID=
CYBERARK_CLIENT_SECRET=
CYBERARK_USERNAME=            # self-hosted only
CYBERARK_PASSWORD=            # self-hosted only

# Mimecast API 2.0
MIMECAST_CLIENT_ID=
MIMECAST_CLIENT_SECRET=

# Netskope REST API v2
NETSKOPE_URL=https://yourco.goskope.com
NETSKOPE_API_TOKEN=
NETSKOPE_APP_EVENTS=false     # true adds risky-app figures (high event volume)

# GitLab
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_GROUPS=
